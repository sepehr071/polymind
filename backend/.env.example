# Flask Configuration
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-me-with-secrets.token_urlsafe-48-output-min-32-bytes
FLASK_DEBUG=False
FLASK_ENV=production

# PostgreSQL
SQLALCHEMY_DATABASE_URI=postgresql+psycopg://postgres:change-me@localhost:5432/unichat

# min 32 chars; generate via: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# OpenRouter API
OPENROUTER_API_KEY=your-openrouter-api-key

# Browser-Use Cloud API (https://browser-use.com)
# Optional
BROWSER_USE_API_KEY=

# Default Admin Account
# Optional. If set, password MUST be >= 16 chars and not in deny-list.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# comma-separated list of allowed origins. For single-host Flask serving SPA, this matches the public backend URL.
CORS_ORIGINS=http://YOUR-SERVER-IP:5000

# ----- Server bind / ports -----
BACKEND_PORT=5000
BACKEND_BIND_HOST=0.0.0.0
GUNICORN_WORKERS=4
GUNICORN_THREADS=16

# Optional: File Storage (for production use S3)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=

# Meeting Assistant (Scribe v2 transcription)
ELEVENLABS_API_KEY=

# Keycloak SSO (optional; leave blank to disable SSO and run on local auth only)
KEYCLOAK_URL=
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_ID=

# Outbound proxy for Iran-VPS deploys (ElevenLabs / pip / non-OR foreign APIs).
# When set, hosts can be rewritten to {OUTBOUND_PROXY_URL}<path>. Leave blank
# for dev/CI outside Iran.
OUTBOUND_PROXY_URL=
OUTBOUND_PROXY_KEY=
#
# OpenRouter path (default DIRECT — preferred / more stable than x-ui proxy):
#   OPENROUTER_USE_PROXY=0  → ignore HTTPS_PROXY; connect directly
#   OPENROUTER_USE_PROXY=1  → tunnel via HTTPS_PROXY / OUTBOUND_PROXY
# Code also forces IPv4 for openrouter.ai (AAAA can fail on some VPS networks).
OPENROUTER_USE_PROXY=0

# DLP smart-scan local LLM (privacy). When DLP_LLM_BASE_URL is set, the DLP
# second-pass classifier runs against a self-hosted Ollama server (native
# /api/chat) instead of OpenRouter — scanned text never leaves company infra.
# The client bypasses OUTBOUND_PROXY/HTTPS_PROXY (Ollama is domestic). Leave
# blank to keep the OpenRouter (google/gemini-3.1-flash-lite) path.
DLP_LLM_BASE_URL=
DLP_LLM_MODEL=qwen3.6:35b
DLP_LLM_VERIFY_SSL=false       # self-signed cert on the Ollama host
DLP_LLM_TIMEOUT=8              # seconds; smart-scan is on the send path, fail-open
DLP_LLM_NUM_CTX=8192           # per-request context window (×OLLAMA_NUM_PARALLEL)
DLP_LLM_MAX_INPUT_CHARS=8000   # message truncation before scanning
